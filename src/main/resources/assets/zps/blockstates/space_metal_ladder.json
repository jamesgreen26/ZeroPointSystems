{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "zps:block/ladder_space"
      }
    },
    {
      "when": {
        "facing": "north",
        "top": "true"
      },
      "apply": {
        "model": "zps:block/ladder_space_hoops"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "zps:block/ladder_space",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "top": "true"
      },
      "apply": {
        "model": "zps:block/ladder_space_hoops",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "zps:block/ladder_space",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "top": "true"
      },
      "apply": {
        "model": "zps:block/ladder_space_hoops",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "zps:block/ladder_space",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "top": "true"
      },
      "apply": {
        "model": "zps:block/ladder_space_hoops",
        "y": 270
      }
    }
  ]
}
