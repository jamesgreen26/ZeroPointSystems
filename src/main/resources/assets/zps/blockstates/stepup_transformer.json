{
    "multipart": [
        {
            "when": {
                "facing": "down",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/stepup_transformer"
            }
        },
        {
            "when": {
                "facing": "up",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/stepup_transformer",
                "x": 180
            }
        },
        {
            "when": {
                "facing": "north",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/stepup_transformer",
                "x": 270
            }
        },
        {
            "when": {
                "facing": "east",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/stepup_transformer",
                "x": 270,
                "y": 90
            }
        },
        {
            "when": {
                "facing": "south",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/stepup_transformer",
                "x": 270,
                "y": 180
            }
        },
        {
            "when": {
                "facing": "west",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/stepup_transformer",
                "x": 270,
                "y": 270
            }
        },
        {
            "when": {
                "facing": "up",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_stepup_transformer"
            }
        },
        {
            "when": {
                "facing": "down",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_stepup_transformer",
                "x": 180
            }
        },
        {
            "when": {
                "facing": "north",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_stepup_transformer",
                "x": 90
            }
        },
        {
            "when": {
                "facing": "east",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_stepup_transformer",
                "x": 90,
                "y": 90
            }
        },
        {
            "when": {
                "facing": "south",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_stepup_transformer",
                "x": 90,
                "y": 180
            }
        },
        {
            "when": {
                "facing": "west",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_stepup_transformer",
                "x": 90,
                "y": 270
            }
        },
        {
            "when": {
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulation_core"
            }
        },
        {
            "when": {
                "insulated": "catwalk"
            },
            "apply": {
                "model": "zps:block/decor/catwalk"
            }
        },
        {
            "when": {
                "insulated": "grating"
            },
            "apply": {
                "model": "zps:block/decor/space_grating_block"
            }
        },
        {
            "when": {
                "north": "true",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/cable_side",
                "x": 90
            }
        },
        {
            "when": {
                "north": "true",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single",
                "x": 90
            }
        },
        {
            "when": {
                "AND": [
                    {"insulated": "insulation"},
                    {"north": "false"},
                    {
                        "OR": [
                            {"facing": "east"},
                            {"facing": "south"},
                            {"facing": "west"},
                            {"facing": "up"},
                            {"facing": "down"}
                        ]
                    }
                ]
            },
            "apply": {
                "model": "zps:block/insulated_end",
                "x": 90
            }
        },
        {
            "when": {
                "south": "true",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/cable_side",
                "x": 90,
                "y": 180
            }
        },
        {
            "when": {
                "south": "true",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single",
                "x": 90,
                "y": 180
            }
        },
        {
            "when": {
                "AND": [
                    {"insulated": "insulation"},
                    {"south": "false"},
                    {
                        "OR": [
                            {"facing": "north"},
                            {"facing": "east"},
                            {"facing": "west"},
                            {"facing": "up"},
                            {"facing": "down"}
                        ]
                    }
                ]
            },
            "apply": {
                "model": "zps:block/insulated_end",
                "x": 90,
                "y": 180
            }
        },
        {
            "when": {
                "east": "true",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/cable_side",
                "x": 90,
                "y": 90
            }
        },
        {
            "when": {
                "east": "true",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single",
                "x": 90,
                "y": 90
            }
        },
        {
            "when": {
                "AND": [
                    {"insulated": "insulation"},
                    {"east": "false"},
                    {
                        "OR": [
                            {"facing": "north"},
                            {"facing": "south"},
                            {"facing": "west"},
                            {"facing": "up"},
                            {"facing": "down"}
                        ]
                    }
                ]
            },
            "apply": {
                "model": "zps:block/insulated_end",
                "x": 90,
                "y": 90
            }
        },
        {
            "when": {
                "west": "true",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/cable_side",
                "x": 90,
                "y": 270
            }
        },
        {
            "when": {
                "west": "true",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single",
                "x": 90,
                "y": 270
            }
        },
        {
            "when": {
                "AND": [
                    {"insulated": "insulation"},
                    {"west": "false"},
                    {
                        "OR": [
                            {"facing": "north"},
                            {"facing": "east"},
                            {"facing": "south"},
                            {"facing": "up"},
                            {"facing": "down"}
                        ]
                    }
                ]
            },
            "apply": {
                "model": "zps:block/insulated_end",
                "x": 90,
                "y": 270
            }
        },
        {
            "when": {
                "up": "true",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/cable_side"
            }
        },
        {
            "when": {
                "up": "true",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single"
            }
        },
        {
            "when": {
                "AND": [
                    {"insulated": "insulation"},
                    {"up": "false"},
                    {
                        "OR": [
                            {"facing": "north"},
                            {"facing": "east"},
                            {"facing": "south"},
                            {"facing": "west"},
                            {"facing": "down"}
                        ]
                    }
                ]
            },
            "apply": {
                "model": "zps:block/insulated_end"
            }
        },
        {
            "when": {
                "down": "true",
                "insulated": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/cable_side",
                "x": 180
            }
        },
        {
            "when": {
                "down": "true",
                "insulated": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single",
                "x": 180
            }
        },
        {
            "when": {
                "AND": [
                    {"insulated": "insulation"},
                    {"down": "false"},
                    {
                        "OR": [
                            {"facing": "north"},
                            {"facing": "east"},
                            {"facing": "south"},
                            {"facing": "west"},
                            {"facing": "up"}
                        ]
                    }
                ]
            },
            "apply": {
                "model": "zps:block/insulated_end",
                "x": 180
            }
        }
    ]
} 