{
  "multipart": [
    {
      "when": {
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/light_pipe_core"
      }
    },
    {
      "when": {
        "facing": "down",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_base"
      }
    },
    {
      "when": {
        "facing": "up",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_base",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "north",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_base",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "east",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_base",
        "x": 270,
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_base",
        "x": 270,
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_base",
        "x": 270,
        "y": 270
      }
    },
    {
      "when": {
        "facing": "down",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_stem"
      }
    },
    {
      "when": {
        "facing": "up",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_stem",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "north",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_stem",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "east",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_stem",
        "x": 270,
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_stem",
        "x": 270,
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/serial_bus_stem",
        "x": 270,
        "y": 270
      }
    },
    {
      "when": {
        "facing": "up",
        "insulated": "insulation"
      },
      "apply": {
        "model": "zps:block/insulated_serial_bus"
      }
    },
    {
      "when": {
        "facing": "down",
        "insulated": "insulation"
      },
      "apply": {
        "model": "zps:block/insulated_serial_bus",
        "x": 180
      }
    },
    {
      "when": {
        "facing": "north",
        "insulated": "insulation"
      },
      "apply": {
        "model": "zps:block/insulated_serial_bus",
        "x": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "insulated": "insulation"
      },
      "apply": {
        "model": "zps:block/insulated_serial_bus",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "insulated": "insulation"
      },
      "apply": {
        "model": "zps:block/insulated_serial_bus",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "insulated": "insulation"
      },
      "apply": {
        "model": "zps:block/insulated_serial_bus",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "insulated": "insulation"
      },
      "apply": {
        "model": "zps:block/insulation_core"
      }
    },
    {
      "when": {
        "insulated": "catwalk"
      },
      "apply": {
        "model": "zps:block/decor/catwalk"
      }
    },
    {
      "when": {
        "insulated": "grating"
      },
      "apply": {
        "model": "zps:block/decor/space_grating_block"
      }
    },
    {
      "when": {
        "north": "true",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/light_pipe_side",
        "x": 90
      }
    },
    {
      "when": {
        "north": "true",
        "insulated": "insulation"
      },
      "apply": {
        "model": "zps:block/insulated_single_light_pipe",
        "x": 90
      }
    },
    {
      "when": {
        "AND": [
          {
            "insulated": "insulation"
          },
          {
            "north": "false"
          },
          {
            "OR": [
              {
                "facing": "east"
              },
              {
                "facing": "south"
              },
              {
                "facing": "west"
              },
              {
                "facing": "up"
              },
              {
                "facing": "down"
              }
            ]
          }
        ]
      },
      "apply": {
        "model": "zps:block/insulated_end",
        "x": 90
      }
    },
    {
      "when": {
        "south": "true",
        "insulated": "none|catwalk|grating"
      },
      "apply": {
        "model": "zps:block/light_pipe_side",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "south": "true",
        "insulated": "insulation"
      },
      "apply": {
        "model": "zps:block/insulated_single_light_pipe",
