              },
              {
                "facing": "east"
              },
              {
                "facing": "west"
              },
              {
                "facing": "up"
              },
              {
                "facing": "down"
              }
            ]
          }
        ]
      },
      "apply": {
        "model": "zps:block/insulated_end",
        "x": 90,
        "y": 180
      }
