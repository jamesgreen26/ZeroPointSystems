{
  "multipart": [
    {
      "apply": {
        "model": "zps:block/gas_duct/core"
      }
    },
    {
      "when": {"north": "connection|leak"},
      "apply": {"model": "zps:block/gas_duct/arm"}
    },
    {
      "when": {"east": "connection|leak"},
      "apply": {"model": "zps:block/gas_duct/arm", "y": 90, "uvlock": true}
    },
    {
      "when": {"south": "connection|leak"},
      "apply": {"model": "zps:block/gas_duct/arm", "y": 180, "uvlock": true}
    },
    {
      "when": {"west": "connection|leak"},
      "apply": {"model": "zps:block/gas_duct/arm", "y": 270, "uvlock": true}
    },
    {
      "when": {"up": "connection|leak"},
      "apply": {"model": "zps:block/gas_duct/arm", "x": 270, "uvlock": true}
    },
    {
      "when": {"down": "connection|leak"},
      "apply": {"model": "zps:block/gas_duct/arm", "x": 90, "uvlock": true}
    }
  ]
}
