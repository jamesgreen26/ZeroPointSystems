        "north": "true",
        "insulation_type": "insulation"
      },
      "apply": {
        "model": "zps:block/insulated_single",
        "x": 90
      }
    },
    {
      "when": {
        "AND": [
          {"insulation_type": "insulation"},
          {"north": "false"},
          {
            "OR": [
              {"facing": "east"},
              {"facing": "south"},
              {"facing": "west"},
              {"facing": "up"},
              {"facing": "down"}
            ]
          }
        ]
      },
      "apply": {
        "model": "zps:block/insulated_end",
        "x": 90
      }
