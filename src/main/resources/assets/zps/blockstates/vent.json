{
  "multipart": [
    {
      "when": {
        "OR": [
          {
            "north": "connection|leak"
          },
          {
            "east": "connection|leak"
          },
          {
            "south": "connection|leak"
          },
          {
            "west": "connection|leak"
          },
          {
            "facing": "north|east|south|west"
          }
        ]
      },
      "apply": {
        "model": "zps:block/gas_duct/core_horizontal"
      }
    },
    {
      "when": {
        "AND": [
          {
            "north": "none"
          },
          {
            "east": "none"
          },
          {
            "south": "none"
          },
          {
            "west": "none"
          },
          {
            "facing": "up|down"
          }
        ]
      },
      "apply": {
        "model": "zps:block/gas_duct/core_vertical"
      }
    },
    {
      "when": {
        "north": "connection|leak"
      },
      "apply": {
        "model": "zps:block/gas_duct/arm_horizontal"
      }
    },
    {
      "when": {
        "east": "connection|leak"
      },
      "apply": {
        "model": "zps:block/gas_duct/arm_horizontal",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "connection|leak"
      },
      "apply": {
        "model": "zps:block/gas_duct/arm_horizontal",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "connection|leak"
      },
      "apply": {
        "model": "zps:block/gas_duct/arm_horizontal",
        "y": 270,
        "uvlock": true
      }
    },
    {
      "when": {
        "up": "connection|leak"
      },
      "apply": {
        "model": "zps:block/gas_duct/arm_up"
      }
    },
    {
      "when": {
        "down": "connection|leak"
      },
      "apply": {
        "model": "zps:block/gas_duct/arm_down"
      }
    },
    {
      "when": {
        "facing": "up"
      },
      "apply": {
        "model": "zps:block/vent/plate_vertical"
      }
    },
    {
      "when": {
        "facing": "down"
      },
      "apply": {
        "model": "zps:block/vent/plate_vertical",
        "x": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "zps:block/vent/plate_horizontal"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "zps:block/vent/plate_horizontal",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "zps:block/vent/plate_horizontal",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "zps:block/vent/plate_horizontal",
        "y": 270,
        "uvlock": true
      }
    }
  ]
}
