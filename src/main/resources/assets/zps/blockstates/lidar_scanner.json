      "apply": {
        "model": "zps:block/lidar_scanner_on",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "powered": "true"
      },
      "apply": {
        "model": "zps:block/lidar_scanner_on",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "up",
        "powered": "true"
      },
      "apply": {
        "model": "zps:block/lidar_scanner_on",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "down",
        "powered": "true"
      },
      "apply": {
        "model": "zps:block/lidar_scanner_on",
        "x": 90
      }
