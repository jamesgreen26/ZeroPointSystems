    "zps.ponder.robotic_arm.text_7": "Interact with the arm to set how many items it moves per action, check its stored energy, and preview its range.",

    "zps.ponder.robotic_arm_use.header": "Robotic Arm: Using Held Items",
    "zps.ponder.robotic_arm_use.text_1": "Besides moving items, the Robotic Arm can use its held item on a block, just like a player would.",
    "zps.ponder.robotic_arm_use.text_2": "Its actions Use, Shift+Use and Drop right-click, sneak-right-click, or drop the held item.",
    "zps.ponder.robotic_arm_use.text_3": "Here it holds an empty Bucket.",
