{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "powered": "false"
      },
      "apply": {
        "model": "zps:block/lidar_scanner"
      }
    },
    {
      "when": {
        "facing": "east",
        "powered": "false"
      },
      "apply": {
        "model": "zps:block/lidar_scanner",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "powered": "false"
      },
      "apply": {
        "model": "zps:block/lidar_scanner",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "powered": "false"
      },
      "apply": {
        "model": "zps:block/lidar_scanner",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "up",
        "powered": "false"
      },
      "apply": {
        "model": "zps:block/lidar_scanner",
        "x": 270
      }
    },
    {
      "when": {
        "facing": "down",
        "powered": "false"
      },
      "apply": {
        "model": "zps:block/lidar_scanner",
        "x": 90
      }
