{
  "multipart": [
    {
      "when": {
        "AND": [
          {"insulated": "none|catwalk|grating"},
          {"north": "true"},
          {"south": "true"},
          {"east": "false"},
          {"west": "false"},
          {"up": "false"},
          {"down": "false"}
        ]
      },
      "apply": {
        "model": "zps:block/dense_cables_straight"
      }
    },
    {
      "when": {
        "AND": [
          {"insulated": "none|catwalk|grating"},
          {"north": "false"},
          {"south": "false"},
          {"east": "true"},
          {"west": "true"},
          {"up": "false"},
          {"down": "false"}
        ]
      },
      "apply": {
        "model": "zps:block/dense_cables_straight",
        "y": 90
      }
    },
    {
      "when": {
        "AND": [
          {"insulated": "none|catwalk|grating"},
          {"north": "false"},
          {"south": "false"},
          {"east": "false"},
          {"west": "false"},
          {"up": "true"},
          {"down": "true"}
        ]
      },
      "apply": {
        "model": "zps:block/dense_cables_straight",
        "x": 90
      }
    },
    {
      "when": {
        "AND": [
          {"insulated": "none|catwalk|grating"},
          {
            "NOT": {
              "AND": [
                {"north": "true"},
                {"south": "true"},
                {"east": "false"},
                {"west": "false"},
                {"up": "false"},
                {"down": "false"}
              ]
            }
          },
          {
            "NOT": {
              "AND": [
                {"east": "true"},
                {"west": "true"},
                {"north": "false"},
                {"south": "false"},
                {"up": "false"},
                {"down": "false"}
              ]
            }
          },
          {
            "NOT": {
              "AND": [
                {"up": "true"},
                {"down": "true"},
                {"north": "false"},
                {"south": "false"},
                {"east": "false"},
                {"west": "false"}
              ]
            }
          }
        ]
      },
      "apply": {
        "model": "zps:block/dense_cable_core"
      }
    },
    {
      "when": {
        "insulated": "insulation"
      },
      "apply": {
        "model": "zps:block/insulation_core"
      }
    },
    {
      "when": {
        "insulated": "catwalk"
      },
      "apply": {
        "model": "zps:block/decor/catwalk"
      }
    },
    {
      "when": {
        "insulated": "grating",
        "north": "true"
      },
      "apply": {
        "model": "zps:block/decor/space_grating_densecable",
        "x": 90
      }
    },
    {
      "when": {
        "insulated": "grating",
        "north": "false"
      },
      "apply": {
        "model": "zps:block/decor/space_grating_face",
        "x": 90
      }
    },
    {
      "when": {
        "insulated": "grating",
        "south": "true"
      },
      "apply": {
        "model": "zps:block/decor/space_grating_densecable",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "insulated": "grating",
        "south": "false"
      },
      "apply": {
        "model": "zps:block/decor/space_grating_face",
        "x": 90,
        "y": 180
      }
    },
    {
