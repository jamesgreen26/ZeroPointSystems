{
    "multipart": [
        {
            "when": {
                "insulation_type": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/light_pipe_core"
            }
        },
        {
            "when": {
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulation_core"
            }
        },
        {
            "when": {
                "insulation_type": "catwalk"
            },
            "apply": {
                "model": "zps:block/decor/catwalk"
            }
        },
        {
            "when": {
                "insulation_type": "grating"
            },
            "apply": {
                "model": "zps:block/decor/space_grating_block"
            }
        },
        {
            "when": {
                "north": "true",
                "insulation_type": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/light_pipe_side",
                "x": 90
            }
        },
        {
            "when": {
                "north": "true",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single_light_pipe",
                "x": 90
            }
        },
        {
            "when": {
                "north": "false",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_end",
                "x": 90
            }
        },
        {
            "when": {
                "south": "true",
                "insulation_type": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/light_pipe_side",
                "x": 90,
                "y": 180
            }
        },
        {
            "when": {
                "south": "true",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single_light_pipe",
                "x": 90,
                "y": 180
            }
        },
        {
            "when": {
                "south": "false",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_end",
                "x": 90,
                "y": 180
            }
        },
        {
            "when": {
                "east": "true",
                "insulation_type": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/light_pipe_side",
                "x": 90,
                "y": 90
            }
        },
        {
            "when": {
                "east": "true",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single_light_pipe",
                "x": 90,
                "y": 90
            }
        },
        {
            "when": {
                "east": "false",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_end",
                "x": 90,
                "y": 90
            }
        },
        {
            "when": {
                "west": "true",
                "insulation_type": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/light_pipe_side",
                "x": 90,
                "y": 270
            }
        },
        {
            "when": {
                "west": "true",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single_light_pipe",
                "x": 90,
                "y": 270
            }
        },
        {
            "when": {
                "west": "false",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_end",
                "x": 90,
                "y": 270
            }
        },
        {
            "when": {
                "up": "true",
                "insulation_type": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/light_pipe_side"
            }
        },
        {
            "when": {
                "up": "true",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single_light_pipe"
            }
        },
        {
            "when": {
                "up": "false",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_end"
            }
        },
        {
            "when": {
                "down": "true",
                "insulation_type": "none|catwalk|grating"
            },
            "apply": {
                "model": "zps:block/light_pipe_side",
                "x": 180
            }
        },
        {
            "when": {
                "down": "true",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_single_light_pipe",
                "x": 180
            }
        },
        {
            "when": {
                "down": "false",
                "insulation_type": "insulation"
            },
            "apply": {
                "model": "zps:block/insulated_end",
                "x": 180
            }
        }
    ]
} 
