    "zps.ponder.robotic_arm_use.text_5": "Shift+Use",
    "zps.ponder.robotic_arm_use.text_6": "Drop",

    "zps.ponder.robotic_arm_script.header": "Robotic Arm: Script Control",
    "zps.ponder.robotic_arm_script.text_1": "Robotic Arms can be automated by a Script Terminal, through a Serial Bus whose interface faces the arm.",
    "zps.ponder.robotic_arm_script.text_2": "Arm commands target a position relative to the arm: take_items, put_items, use, shift_use and drop_items.",
    "zps.ponder.robotic_arm_script.text_3": "take_items ~2 ~ ~",
    "zps.ponder.robotic_arm_script.text_4": "put_items ~ ~ ~2",
    "zps.ponder.robotic_arm_script.text_5": "Commands are dispatched in sequence each time the Terminal is powered.",
    "zps.ponder.robotic_arm_script.text_6": "Combined with conditions and loops, this allows fully automated item handling.",

    "zps.ponder.tag.can_insulate": "Blocks that can be Insulated",
    "zps.ponder.tag.can_insulate.description": "Components or Blocks which can have Cable Insulation applied to them, which prevents the block from connecting in new directions.",

    "zps.ponder.tag.has_script_caps": "Blocks with Script Capabilities",
    "zps.ponder.tag.has_script_caps.description": "Blocks which have extra Script Capabilities beyond the default 'set_redstone' command.",

    "creativetab.zps_tab_deco": "Zero Point Systems Blocks",

    "block.zps.switch_panel.zps_tooltip": "4 levers in 1!\n\nEach switch controls one of the four outputs. Connects with [Dense Cables].",
    "block.zps.graduated_lever.zps_tooltip": "Allows precise control of a redstone signal.\n\nInteract with the upper or lower half of the block to increase or decrease signal strength. Connects with [Cable].",
    "block.zps.catwalk.zps_tooltip": "Can be placed on cable blocks to prevent upwards connection.",
    "block.zps.space_grating_block.zps_tooltip": "Can be placed on cable blocks to prevent connection in new directions.",


    "block.zps.radio_transmitter.zps_tooltip": "Transmits a radio signal with data from a [Light-Pipe Data Cable].\n\nTune the radio frequency with [Shift + Right Click]. Higher frequencies have a longer range and require a taller [Radio Antenna] on top.",
    "block.zps.radio_receiver.zps_tooltip": "Receives a radio signal and sends the data over a [Light-Pipe Data Cable].\n\nTune the radio frequency with [Shift + Right Click]. Higher frequencies have a longer range and require a taller [Radio Antenna] on top.",

    "block.zps.loudspeaker.zps_tooltip": "Converts messages from a [Light-Pipe Data Cable] into spoken audio.",

    "block.zps.data_comparator.zps_tooltip": "Compares signals from two connected [Light-Pipe Data Cables] according to the current mode.\n\n[Equals]: provides Redstone power when data from the two inputs match exactly.\n\n[Contains]: provides Redstone power when data from the first input contains the full data from the second.\n\n[Greater Than]: provides Redstone power when both inputs can be parsed as numbers and the first is greater than the second.\n\n[Shift + R-Click] to switch Modes.",

    "block.zps.data_combinator.zps_tooltip": "Combines two [Light-Pipe Data Cable] inputs into one output according to the current mode.\n\n[Back]: output port.\n[Left]: Input A. [Right]: Input B.\n\n[Append]: passthrough behavior for single inputs, and appends Input B to Input A when both are present.\n\n[Replace]: passthrough from Input A unless Input B is present and Input A contains [%s], in which case the first occurrence is replaced with Input B.\n\n[Shift + R-Click] to switch Modes.",

    "block.zps.dodeca_controller.zps_tooltip": "More... MORE!!",
    "item.zps.address_pad.zps_tooltip": "Saves named block positions as Addresses.\n\n[R-Click a block]: creates a new Address at that position (max 15).\n\n[R-Click the air]: opens GUI to manage saved Addresses.\n\n[R-Click a Script Terminal]: places the Address Pad on the Script Terminal, allowing the Addresses to be used in Script Commands.",

