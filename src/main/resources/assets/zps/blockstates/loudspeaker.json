		{
			"when": {
				"facing": "west"
			},
			"apply": {
				"model": "zps:block/loudspeaker",
				"y": 270
			}
		},
		{
			"when": {
				"facing": "up"
			},
			"apply": {
				"model": "zps:block/loudspeaker",
				"x": 270
			}
		},
		{
			"when": {
				"facing": "down"
			},
			"apply": {
				"model": "zps:block/loudspeaker",
