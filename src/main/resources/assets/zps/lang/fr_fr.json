    "zps.ponder.cable.header": "Câbles",
    "zps.ponder.cable.text_1": "Les Câbles ne font rien eux-mêmes",
    "zps.ponder.cable.text_2": "Ajoutez des Convertisseurs de Redstone pour envoyer un signal de redstone.",

    "zps.ponder.energy.header": "Câbles d'Énergie",
    "zps.ponder.energy.text_1": "Les Transfoextracteurs extraient de l'Énergie de leur bloc adjacent...",
    "zps.ponder.energy.text_2": "...et la dépose sur les Transfoinjecteurs connectés.",

    "zps.ponder.energy_explode.header": "Surcharger les Convertisseurs Redstone",
    "zps.ponder.energy_explode.text_1": "Ne donnez pas d'énergie à un Convertisseur Redstone",
    "zps.ponder.energy_explode.text_2": "Sinon vous avez créé une Bombe, pas un vaisseau spatial, ce serait con quand même...",

    "zps.ponder.insulation.header": "Gaines",
    "zps.ponder.insulation.text_1": "Les câbles ont la fâcheuse manie de se connecter intempestivement, falsifiant les signaux",
    "zps.ponder.insulation.text_2": "Mais les gaines vous permettent d'empêcher les câbles de faire n'importe quoi!",

    "zps.ponder.dense_cables.header": "Câbles denses",
    "zps.ponder.dense_cables.text_1": "Les espaces restreints, c'est énervant quand on veut faire de la connectivité",
    "zps.ponder.dense_cables.text_2": "Les Câbles denses peuvent transmettre 4 signaux à travers un seul bloc.",
    "zps.ponder.dense_cables.text_3": "Utilisez les gaines pour fusionner plusieurs câbles réguliers en un Câble denses.",

    "zps.ponder.octo_controller.header": "Controlleur Octogonal",
    "zps.ponder.octo_controller.text_1": "Interagissez avec le contrôleur octogonal pour le contrôler.",
    "zps.ponder.octo_controller.text_2": "Utilisez les touches fléchées et ZQSD pour contrôler les 8 sorties de redstone.",

    "zps.ponder.data_cable.header": "Câbles de données",
    "zps.ponder.data_cable.text_1": "Les Câbles de données envoient des informations sous forme de texte entre blocs compatibles.",
    "zps.ponder.data_cable.text_2": "Une configuration minimale comprend une entrée et une sortie.",
    "zps.ponder.data_cable.text_3": "Les données fournies à l'entrée sont envoyées à toutes les sorties connectées.",

    "zps.ponder.script_terminal.header": "Terminal",
    "zps.ponder.script_terminal.text_1": "Le terminal envoie des commandes par le biais des bus.",
    "zps.ponder.script_terminal.text_2": "Pour entrer des commandes, interagissez avec le terminal pour ouvrir une interface.",
    "zps.ponder.script_terminal.text_3": "Lorsqu'alimenté par de la redstone, le terminal exécute toutes les commandes entrées.",
    "zps.ponder.script_terminal.text_4": "Chaque commande est exécutée une fois pour chaque bus connecté.",
    "zps.ponder.script_terminal.text_5": "if block == minecraft:piston[facing=up] set_redstone 15",
    "zps.ponder.script_terminal.text_6": "set_redstone 0",

    "zps.ponder.data_transcriber.header": "Transcripteur de données",
