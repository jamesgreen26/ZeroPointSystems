{
  "multipart": [
    {
      "apply": {
        "model": "zps:block/insulation_core"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "zps:block/insulated_single",
        "x": 90
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "zps:block/insulated_end",
        "x": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "zps:block/insulated_single",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "zps:block/insulated_end",
        "x": 90,
        "y": 180
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "zps:block/insulated_single",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "zps:block/insulated_end",
        "x": 90,
        "y": 90
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "zps:block/insulated_single",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "zps:block/insulated_end",
        "x": 90,
        "y": 270
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "zps:block/insulated_single"
      }
    },
    {
      "when": {
        "up": "false"
      },
      "apply": {
        "model": "zps:block/insulated_end"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "zps:block/insulated_single",
        "x": 180
      }
    },
    {
      "when": {
        "down": "false"
      },
      "apply": {
        "model": "zps:block/insulated_end",
        "x": 180
      }
    }
  ]
}