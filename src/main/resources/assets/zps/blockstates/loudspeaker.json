{
	"multipart": [
		{
			"when": {
				"facing": "north"
			},
			"apply": {
				"model": "zps:block/loudspeaker"
			}
		},
		{
			"when": {
				"facing": "east"
			},
			"apply": {
				"model": "zps:block/loudspeaker",
				"y": 90
			}
		},
		{
			"when": {
				"facing": "south"
			},
			"apply": {
				"model": "zps:block/loudspeaker",
